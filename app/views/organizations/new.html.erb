<h1>New organization</h1>

<% if @organization.errors.any? %>
  <ul role="alert">
    <% @organization.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @organization, url: organizations_path, local: true do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :slug %>
    <%= f.text_field :slug %>
  </div>
  <%= f.submit "Create" %>
<% end %>
