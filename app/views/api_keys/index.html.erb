<% mcp_url = "https://#{Rails.application.config.x.main_host}/mcp" %>

<div class="page-head">
  <h1>API keys</h1>
</div>

<% if flash[:new_api_key] %>
  <div class="card card-highlight">
    <h3>Your new API key</h3>
    <p class="muted">Copy it now &mdash; it will not be shown again.</p>
    <pre class="snippet"><%= flash[:new_api_key] %></pre>
    <p class="muted">Connect it in one command &mdash; run this in your terminal (requires <a href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code</a>; works on macOS, Windows, and Linux):</p>
    <pre class="snippet">claude mcp add --transport http --scope user mcpublish <%= mcp_url %> --header "Authorization: Bearer <%= flash[:new_api_key] %>"</pre>
    <p class="muted">Then open Claude Code and say <em>&ldquo;McPublish a page that&hellip;&rdquo;</em></p>
  </div>
<% end %>

<div class="card">
  <ul class="row-list">
    <% @api_keys.each do |api_key| %>
      <li class="row-item">
        <span><%= api_key.label %><% if api_key.revoked? %> <span class="muted">(revoked)</span><% end %></span>
        <% unless api_key.revoked? %>
          <span class="row-actions">
            <%= button_to "Revoke", api_key_path(api_key), method: :delete, class: "linklike" %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>

<div class="card">
  <%= form_with url: api_keys_path, local: true, class: "inline-form" do |f| %>
    <div class="form-field">
      <%= f.label :label, "New key label" %>
      <%= f.text_field :label %>
    </div>
    <%= f.submit "Generate key", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="card">
  <h3>Connect your AI</h3>
  <p class="muted">Run this in your terminal, replacing <code>YOUR_API_KEY</code> with a key from above (requires <a href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code</a>; works on macOS, Windows, and Linux):</p>
  <pre class="snippet">claude mcp add --transport http --scope user mcpublish <%= mcp_url %> --header "Authorization: Bearer YOUR_API_KEY"</pre>
  <p class="muted">Then open Claude Code and say <em>&ldquo;McPublish a page that&hellip;&rdquo;</em></p>
  <p class="muted">Using another AI tool? Any MCP client that supports HTTP transport with an <code>Authorization</code> header can connect &mdash; the endpoint is <code><%= mcp_url %></code>.</p>
</div>
